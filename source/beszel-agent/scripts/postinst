#!/bin/bash
# Post-installation script for Beszel Agent
# Downloads binary, creates user, sets up configuration

set -e

PACKAGE="beszel-agent"
USER="beszel"
LOG_FILE="/tmp/beszel-agent-install.log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

log "Starting post-installation setup..."

# Create user if it doesn't exist
if ! synouser --get "$USER" &>/dev/null; then
    log "Creating user '$USER'..."
    synouser --add "$USER" "" "Beszel Agent" 0 "" 0
    # Disable login for security
    synouser --setpw "$USER" "$(openssl rand -base64 32)"
    log "User '$USER' created with disabled login"
else
    log "User '$USER' already exists"
fi

# Create necessary directories
log "Creating data directories..."
mkdir -p "${SYNOPKG_PKGDEST}/var/lib"
mkdir -p "${SYNOPKG_PKGDEST}/var"
mkdir -p "${SYNOPKG_PKGDEST}/etc"

# Download appropriate architecture binary if not present
if [ ! -f "${SYNOPKG_PKGDEST}/bin/beszel-agent" ]; then
    log "Detecting system architecture..."
    ARCH=$(uname -m)
    case "$ARCH" in
      x86_64)
        DOWNLOAD_ARCH="amd64"
        ;;
      aarch64)
        DOWNLOAD_ARCH="arm64"
        ;;
      armv7l|armv7)
        DOWNLOAD_ARCH="arm"
        ;;
      *)
        log "ERROR: Unsupported architecture: $ARCH"
        echo "Unsupported architecture: $ARCH"
        exit 1
        ;;
    esac

    log "Architecture detected: $ARCH (downloading $DOWNLOAD_ARCH binary)"

    mkdir -p "${SYNOPKG_PKGDEST}/bin"
    DOWNLOAD_URL="https://github.com/henrygd/beszel/releases/latest/download/beszel-agent_Linux_${DOWNLOAD_ARCH}.tar.gz"

    log "Downloading Beszel agent binary from $DOWNLOAD_URL..."
    if ! curl -sL "$DOWNLOAD_URL" | tar -xz -C "${SYNOPKG_PKGDEST}/bin/" 2>&1 | tee -a "$LOG_FILE"; then
        log "ERROR: Failed to download Beszel agent binary"
        echo "Failed to download Beszel agent binary from $DOWNLOAD_URL"
        exit 1
    fi

    log "Binary downloaded successfully"
else
    log "Binary already exists, skipping download"
fi

# Verify binary exists
if [ ! -f "${SYNOPKG_PKGDEST}/bin/beszel-agent" ]; then
    log "ERROR: Binary not found after extraction"
    echo "Binary not found after extraction"
    exit 1
fi

# Set up configuration from wizard inputs
log "Creating configuration file..."
cat > "${SYNOPKG_PKGDEST}/etc/beszel-agent.conf" << EOF
# Beszel Agent Configuration
# Generated on $(date)

export PORT="${pkgwizard_port:-45876}"
export KEY="$pkgwizard_ssh_key"
export LISTEN="${pkgwizard_port:-45876}"
EOF

# Add extra filesystems if specified
if [ -n "$pkgwizard_extra_filesystems" ]; then
    echo "export EXTRA_FILESYSTEMS=\"$pkgwizard_extra_filesystems\"" >> "${SYNOPKG_PKGDEST}/etc/beszel-agent.conf"
    log "Extra filesystems configured: $pkgwizard_extra_filesystems"
fi

# Set ownership to beszel user
log "Setting file permissions and ownership..."
chown -R ${USER}:${USER} "${SYNOPKG_PKGDEST}/var"
chown ${USER}:${USER} "${SYNOPKG_PKGDEST}/etc/beszel-agent.conf"
chmod 755 "${SYNOPKG_PKGDEST}/bin/beszel-agent"
chmod 600 "${SYNOPKG_PKGDEST}/etc/beszel-agent.conf"

# If Docker monitoring requested and Docker is installed
if [ "$pkgwizard_monitor_docker" = "true" ]; then
    log "Docker monitoring requested..."
    if [ -S /var/run/docker.sock ]; then
        if synogroup --get docker > /dev/null 2>&1; then
            synogroup --member docker "$USER" 2>&1 | tee -a "$LOG_FILE" || true
            log "User '$USER' added to docker group"
        else
            log "WARNING: Docker group not found"
        fi
    else
        log "WARNING: Docker socket not found"
    fi
fi

log "Post-installation setup completed successfully"
exit 0
